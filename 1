
#include <stdio.h>
#include <string.h>

int main()
{
    int choice, i, count = 0;
    char data[100];

    printf("Enter the data: ");
    scanf("%s", data);

    printf("\n1. Character Count");
    printf("\n2. Character Stuffing");
    printf("\n3. Bit Stuffing");

    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    switch(choice)
    {
        case 1:
            printf("\nCharacter Count: %lu",
                   strlen(data) + 1);
            printf("\nData: %s", data);
            break;

        case 2:
            printf("\nStuffed Data: FLAG ");

            for(i = 0; data[i] != '\0'; i++)
            {
                if(data[i] == 'F' || data[i] == 'E')
                    printf("E");

                printf("%c", data[i]);
            }

            printf(" FLAG");
            break;

        case 3:
            count = 0;

            printf("\nBit Stuffed Data: ");

            for(i = 0; data[i] != '\0'; i++)
            {
                printf("%c", data[i]);

                if(data[i] == '1')
                    count++;
                else
                    count = 0;

                if(count == 5)
                {
                    printf("0");
                    count = 0;
                }
            }
            break;

        default:
            printf("\nInvalid choice!");
    }

    return 0;
}
