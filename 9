
#include <stdio.h>
#include <string.h>

struct frame
{
    char text[4];
    int seq;
};

int main()
{
    struct frame f[50], temp;
    char str[150];
    int n = 0, i, j;

    printf("Enter the message: ");
    scanf("%149s", str);

    // Divide message into frames
    for(i = 0; i < strlen(str); i += 3)
    {
        for(j = 0; j < 3 && str[i+j] != '\0'; j++)
            f[n].text[j] = str[i+j];

        f[n].text[j] = '\0';
        f[n].seq = n;
        n++;
    }

    printf("\nAfter assigning sequence numbers:\n");
    for(i = 0; i < n; i++)
        printf("%d:%s ", f[i].seq, f[i].text);

    // Shuffle frames
    for(i = 0; i < n/2; i++)
    {
        temp = f[i];
        f[i] = f[n-1-i];
        f[n-1-i] = temp;
    }

    printf("\n\nAFTER SHUFFLING:\n");
    for(i = 0; i < n; i++)
        printf("%d:%s ", f[i].seq, f[i].text);

    // Sort frames
    for(i = 0; i < n-1; i++)
    {
        for(j = 0; j < n-i-1; j++)
        {
            if(f[j].seq > f[j+1].seq)
            {
                temp = f[j];
                f[j] = f[j+1];
                f[j+1] = temp;
            }
        }
    }

    printf("\n\nAFTER SORTING:\n");
    for(i = 0; i < n; i++)
        printf("%s", f[i].text);

    printf("\n");

    return 0;
}
